generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  VIEWER
}

enum PlatformRole {
  SUPER
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum FamilyStatus {
  ACTIVE
  DISABLED
}

enum FamilyType {
  STANDARD
  DEMO
  TEMPLATE
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum InvitationType {
  FAMILY_ADMIN
  FAMILY_MEMBER
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

enum LifeStatus {
  ALIVE
  DECEASED
  UNKNOWN
}

enum MarriageStatus {
  ACTIVE
  DIVORCED
  WIDOWED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  RESTORE
  EXPORT
  UPLOAD_PHOTO
  ROLE_CHANGE
}

model User {
  id                          String              @id @default(cuid())
  username                    String              @unique
  phone                       String?             @unique
  displayName                 String?
  passwordHash                String
  tokenVersion                Int                 @default(0)
  refreshTokenHash            String?
  refreshTokenExpiresAt       DateTime?
  platformRole                PlatformRole        @default(USER)
  role                        UserRole            @default(VIEWER)
  status                      UserStatus          @default(ACTIVE)
  lastActiveFamilyId          String?
  lastLoginAt                 DateTime?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  lastActiveFamily            Family?             @relation("LastActiveFamily", fields: [lastActiveFamilyId], references: [id], onDelete: SetNull)
  createdFamilies             Family[]            @relation("FamilyCreator")
  memberships                 FamilyMembership[]
  createdInvitations          Invitation[]        @relation("InvitationCreator")
  usedInvitations             Invitation[]        @relation("InvitationUser")
  auditLogs                   AuditLog[]
  submittedSupplementRequests SupplementRequest[] @relation("SupplementRequester")
  reviewedSupplementRequests  SupplementRequest[] @relation("SupplementReviewer")
  uploadedMemberAssets        MemberAsset[]
  createdMemberEvents         MemberEvent[]
  demoResetHistories          DemoResetHistory[]

  @@index([refreshTokenHash])
  @@index([lastActiveFamilyId])
}

model Family {
  id                 String                   @id @default(cuid())
  name               String
  status             FamilyStatus             @default(ACTIVE)
  familyType         FamilyType               @default(STANDARD)
  resetTemplateKey   String?
  createdById        String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  createdBy          User?                    @relation("FamilyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  activeUsers        User[]                   @relation("LastActiveFamily")
  memberships        FamilyMembership[]
  invitations        Invitation[]
  members            Member[]
  marriages          Marriage[]
  assetTags          AssetTag[]
  assetSources       AssetSource[]
  memberEvents       MemberEvent[]
  memberAssets       MemberAsset[]
  supplementRequests SupplementRequest[]
  requestAssets      SupplementRequestAsset[]
  kinshipAliases     KinshipAlias[]
  auditLogs          AuditLog[]
  demoResetHistories DemoResetHistory[]

  @@index([status])
  @@index([familyType])
  @@index([createdById])
  @@index([resetTemplateKey])
}

model FamilyMembership {
  id        String           @id @default(cuid())
  familyId  String
  userId    String
  role      UserRole         @default(VIEWER)
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  family    Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
  @@index([familyId, role])
  @@index([userId, status])
}

model Invitation {
  id          String         @id @default(cuid())
  codeHash    String         @unique
  type        InvitationType
  familyId    String?
  targetRole  UserRole       @default(VIEWER)
  createdById String?
  usedById    String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  family      Family?        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User?          @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  usedBy      User?          @relation("InvitationUser", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([createdById])
  @@index([usedById])
  @@index([expiresAt])
}

model Member {
  id                 String              @id @default(cuid())
  familyId           String?
  name               String
  gender             Gender              @default(UNKNOWN)
  birthDate          DateTime?
  deathDate          DateTime?
  lifeStatus         LifeStatus          @default(ALIVE)
  photoPath          String?
  generationName     String?
  birthOrder         Int?
  nativePlace        String?
  fatherId           String?
  motherId           String?
  notes              String?
  isDeleted          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  father             Member?             @relation("FatherChildren", fields: [fatherId], references: [id], onDelete: SetNull)
  mother             Member?             @relation("MotherChildren", fields: [motherId], references: [id], onDelete: SetNull)
  family             Family?             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  fatherChildren     Member[]            @relation("FatherChildren")
  motherChildren     Member[]            @relation("MotherChildren")
  marriagesAsMember  Marriage[]          @relation("MarriageMember")
  marriagesAsSpouse  Marriage[]          @relation("MarriageSpouse")
  supplementRequests SupplementRequest[]
  assets             MemberAsset[]
  events             MemberEvent[]

  @@index([familyId])
  @@index([familyId, name])
  @@index([fatherId])
  @@index([motherId])
  @@index([isDeleted])
}

model AssetTag {
  id        String   @id @default(cuid())
  familyId  String?
  name      String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  family    Family?  @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, name])
  @@index([familyId])
  @@index([enabled, sortOrder])
}

model AssetSource {
  id        String   @id @default(cuid())
  familyId  String?
  name      String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  family    Family?  @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, name])
  @@index([familyId])
  @@index([enabled, sortOrder])
}

enum MemberEventType {
  BIRTH
  MARRIAGE
  DIVORCE
  DEATH
  MOVE
  CAREER
  HONOR
  STORY
  OTHER
}

model MemberEvent {
  id          String          @id @default(cuid())
  familyId    String?
  memberId    String
  createdById String?
  eventType   MemberEventType
  title       String
  description String?
  eventDate   DateTime
  isDeleted   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  family      Family?         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member      Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([memberId])
  @@index([createdById])
  @@index([eventType])
  @@index([eventDate])
  @@index([isDeleted])
}

enum MemberAssetCategory {
  PHOTO
  DOCUMENT
}

model MemberAsset {
  id           String              @id @default(cuid())
  familyId     String?
  memberId     String
  uploadedById String?
  category     MemberAssetCategory
  filePath     String
  originalName String
  checksum     String?
  title        String?
  sourceType   String?
  source       String?
  description  String?
  tags         String[]            @default([])
  mimeType     String
  sizeBytes    Int
  isDeleted    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  family       Family?             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member       Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  uploadedBy   User?               @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([memberId])
  @@index([uploadedById])
  @@index([category])
  @@index([isDeleted])
  @@index([createdAt])
  @@index([checksum])
}

enum SupplementRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SupplementRequestType {
  BASIC_INFO
  PHOTO
  DOCUMENT
  MEMBER_CREATE
  MEMBER_UPDATE
  MEMBER_DELETE
  MEMBER_RESTORE
  QUICK_RELATIVE
  MARRIAGE_CREATE
  MARRIAGE_UPDATE
  MARRIAGE_DELETE
  MARRIAGE_RESTORE
  MEMBER_PHOTO
  ASSET_UPDATE
  ASSET_DELETE
  EVENT_CREATE
  EVENT_DELETE
  MEMBER_IMPORT
}

model SupplementRequest {
  id            String                   @id @default(cuid())
  familyId      String?
  memberId      String?
  requesterId   String
  reviewerId    String?
  requestType   SupplementRequestType    @default(BASIC_INFO)
  status        SupplementRequestStatus  @default(PENDING)
  patch         Json
  beforeSnapshot Json?
  afterSnapshot  Json?
  payload       Json?
  reason        String?
  reviewComment String?
  reviewedAt    DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  family        Family?                  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member        Member?                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  requester     User                     @relation("SupplementRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer      User?                    @relation("SupplementReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  assets        SupplementRequestAsset[]

  @@index([familyId])
  @@index([memberId])
  @@index([requesterId])
  @@index([reviewerId])
  @@index([requestType])
  @@index([status])
  @@index([createdAt])
}

model SupplementRequestAsset {
  id           String              @id @default(cuid())
  familyId     String?
  requestId    String
  category     MemberAssetCategory
  filePath     String
  originalName String
  checksum     String?
  title        String?
  sourceType   String?
  source       String?
  description  String?
  tags         String[]            @default([])
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  family       Family?             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  request      SupplementRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([requestId])
  @@index([category])
  @@index([createdAt])
  @@index([checksum])
}

model Marriage {
  id        String         @id @default(cuid())
  familyId  String?
  pairKey   String         @unique
  memberId  String
  spouseId  String
  status    MarriageStatus @default(ACTIVE)
  startDate DateTime?
  endDate   DateTime?
  isDeleted Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  family    Family?        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member    Member         @relation("MarriageMember", fields: [memberId], references: [id], onDelete: Cascade)
  spouse    Member         @relation("MarriageSpouse", fields: [spouseId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([memberId])
  @@index([spouseId])
  @@index([isDeleted])
}

model KinshipAlias {
  id           String   @id @default(cuid())
  familyId     String?
  relationCode String
  standardTerm String
  familyAlias  String
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  family       Family?  @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, relationCode])
  @@index([familyId])
  @@index([enabled])
}

model AuditLog {
  id         String      @id @default(cuid())
  familyId   String?
  operatorId String?
  action     AuditAction
  targetType String
  targetId   String?
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime    @default(now())
  family     Family?     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  operator   User?       @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([operatorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model DemoResetHistory {
  id                 String   @id @default(cuid())
  familyId           String
  familyNameSnapshot String
  templateKey        String
  operatorId         String?
  summary            Json
  createdAt          DateTime @default(now())
  family             Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  operator           User?    @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([operatorId])
  @@index([templateKey])
  @@index([createdAt])
}
