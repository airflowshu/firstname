generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

enum LifeStatus {
  ALIVE
  DECEASED
  UNKNOWN
}

enum MarriageStatus {
  ACTIVE
  DIVORCED
  WIDOWED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  RESTORE
  EXPORT
  UPLOAD_PHOTO
  ROLE_CHANGE
}

model User {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String
  role         UserRole    @default(VIEWER)
  status       UserStatus  @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  auditLogs    AuditLog[]
  submittedSupplementRequests SupplementRequest[] @relation("SupplementRequester")
  reviewedSupplementRequests  SupplementRequest[] @relation("SupplementReviewer")
  uploadedMemberAssets        MemberAsset[]
  createdMemberEvents         MemberEvent[]
}

model Member {
  id                String        @id @default(cuid())
  name              String
  gender            Gender        @default(UNKNOWN)
  birthDate         DateTime?
  deathDate         DateTime?
  lifeStatus        LifeStatus    @default(ALIVE)
  photoPath         String?
  generationName    String?
  birthOrder        Int?
  nativePlace       String?
  fatherId          String?
  motherId          String?
  notes             String?
  isDeleted         Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  father            Member?       @relation("FatherChildren", fields: [fatherId], references: [id], onDelete: SetNull)
  mother            Member?       @relation("MotherChildren", fields: [motherId], references: [id], onDelete: SetNull)
  fatherChildren    Member[]      @relation("FatherChildren")
  motherChildren    Member[]      @relation("MotherChildren")
  marriagesAsMember Marriage[]    @relation("MarriageMember")
  marriagesAsSpouse Marriage[]    @relation("MarriageSpouse")
  supplementRequests SupplementRequest[]
  assets            MemberAsset[]
  events            MemberEvent[]

  @@index([name])
  @@index([fatherId])
  @@index([motherId])
  @@index([isDeleted])
}

enum MemberEventType {
  BIRTH
  MARRIAGE
  DIVORCE
  DEATH
  MOVE
  CAREER
  HONOR
  STORY
  OTHER
}

model MemberEvent {
  id          String          @id @default(cuid())
  memberId     String
  createdById  String?
  eventType    MemberEventType
  title        String
  description  String?
  eventDate    DateTime
  isDeleted    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  member       Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@index([createdById])
  @@index([eventType])
  @@index([eventDate])
  @@index([isDeleted])
}

enum MemberAssetCategory {
  PHOTO
  DOCUMENT
}

model MemberAsset {
  id           String              @id @default(cuid())
  memberId      String
  uploadedById  String?
  category      MemberAssetCategory
  filePath      String
  originalName  String
  mimeType      String
  sizeBytes     Int
  isDeleted     Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  member        Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  uploadedBy    User?               @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([memberId])
  @@index([uploadedById])
  @@index([category])
  @@index([isDeleted])
  @@index([createdAt])
}

enum SupplementRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SupplementRequestType {
  BASIC_INFO
  PHOTO
  DOCUMENT
}

model SupplementRequest {
  id            String                  @id @default(cuid())
  memberId       String
  requesterId    String
  reviewerId     String?
  requestType    SupplementRequestType  @default(BASIC_INFO)
  status         SupplementRequestStatus @default(PENDING)
  patch          Json
  reason         String?
  reviewComment  String?
  reviewedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  member         Member                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  requester      User                   @relation("SupplementRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer       User?                  @relation("SupplementReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  assets         SupplementRequestAsset[]

  @@index([memberId])
  @@index([requesterId])
  @@index([reviewerId])
  @@index([requestType])
  @@index([status])
  @@index([createdAt])
}

model SupplementRequestAsset {
  id           String              @id @default(cuid())
  requestId     String
  category      MemberAssetCategory
  filePath      String
  originalName  String
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  request       SupplementRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([category])
  @@index([createdAt])
}

model Marriage {
  id        String         @id @default(cuid())
  pairKey   String         @unique
  memberId  String
  spouseId  String
  status    MarriageStatus @default(ACTIVE)
  startDate DateTime?
  endDate   DateTime?
  isDeleted Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  member    Member         @relation("MarriageMember", fields: [memberId], references: [id], onDelete: Cascade)
  spouse    Member         @relation("MarriageSpouse", fields: [spouseId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([spouseId])
  @@index([isDeleted])
}

model KinshipAlias {
  id           String   @id @default(cuid())
  relationCode String   @unique
  standardTerm String
  familyAlias  String
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([enabled])
}

model AuditLog {
  id         String      @id @default(cuid())
  operatorId String?
  action     AuditAction
  targetType String
  targetId   String?
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime    @default(now())
  operator   User?       @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([operatorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
