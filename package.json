{
  "name": "fisrtname-family-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "concurrently -n WEB,API -c blue,green \"pnpm --filter @fisrtname/web dev\" \"pnpm --filter @fisrtname/api start:dev\"",
    "build": "pnpm -r --filter ./apps/* build",
    "lint": "pnpm -r --filter ./apps/* lint",
    "test": "pnpm -r --filter ./apps/* test",
    "format": "pnpm -r --filter ./apps/* format",
    "db:generate": "pnpm --filter @fisrtname/api prisma generate",
    "db:migrate": "pnpm --filter @fisrtname/api prisma migrate dev",
    "db:seed": "pnpm --filter @fisrtname/api prisma db seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
